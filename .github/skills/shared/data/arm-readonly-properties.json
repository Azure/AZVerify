{
  "version": 1,
  "consumedBy": [
    "scripts/Get-AzureResourceModel.ps1"
  ],
  "notes": [
    "Rules apply to the 'properties' bag of a resource in the shared resource model.",
    "Path rules (removePaths / keepPaths) match the dotted property path and take precedence over the generic name rules; keepPaths wins over removePaths.",
    "'sku', 'kind', 'location', and 'tags' are deployable inputs and are never stripped.",
    "Names in alwaysRemoveAtRoot are only stripped at the root of the properties bag, because nested 'name'/'id'/'type' values (subnets, IP configurations, app settings) are deployable inputs.",
    "Secret detection also inspects name/value pairs (app settings, connection strings): when the 'name' matches a secret pattern, the pair is reported as '<path>[<name>]' and its value is replaced with '***'. Path patterns classify credential-bearing action-group receiver URLs."
  ],
  "alwaysRemoveAnyDepth": [
    "provisioningState",
    "resourceGuid",
    "etag",
    "createdDate",
    "createdTime",
    "lastModifiedDate",
    "lastModifiedTime",
    "lastEnabledTime",
    "changedTime"
  ],
  "alwaysRemoveAtRoot": [
    "id",
    "name",
    "type",
    "uniqueId",
    "tenantId"
  ],
  "removePaths": [
    "identity.principalId",
    "identity.tenantId",
    "networkProfile.resourceGuid",
    "privateEndpointConnections",
    "subnets.id",
    "subnets.type",
    "subnets.resourceGroup",
    "subnets.properties.resourceGroup",
    "subnets.properties.ipConfigurations",
    "subnets.properties.privateEndpoints",
    "ipConfigurations.id",
    "ipConfigurations.type",
    "ipConfigurations.resourceGroup",
    "ipConfigurations.properties.subnet.resourceGroup",
    "networkSecurityGroup.resourceGroup",
    "dnsSettings.appliedDnsServers",
    "dnsSettings.internalDomainNameSuffix",
    "dnsSettings.internalFqdn",
    "routes.id",
    "routes.type",
    "routes.resourceGroup",
    "securityRules.id",
    "securityRules.type",
    "securityRules.resourceGroup"
  ],
  "keepPaths": [
    "identity.type",
    "identity.userAssignedIdentities"
  ],
  "secretPatterns": {
    "namePatterns": [
      "*password*",
      "*secret*",
      "*key*",
      "*connectionstring*",
      "*accesskey*",
      "*sastoken*",
      "*instrumentationkey*"
    ],
    "nameExclusionPatterns": [
      "keyVault*",
      "*publicKey*",
      "*keyVaultUri*",
      "*keyVaultReferenceIdentity*",
      "keySource",
      "keyType",
      "keyCreationTime",
      "key[0-9]*",
      "allowSharedKeyAccess"
    ],
    "pathPatterns": [
      "azureFunctionReceivers.httpTriggerUrl",
      "logicAppReceivers.callbackUrl",
      "webhookReceivers.serviceUri"
    ],
    "maskedValueRegex": "^\\*{2,}$"
  }
}
