{
  "version": 1,
  "childCollections": [
    {
      "parentType": "Microsoft.Insights/privateLinkScopes",
      "collection": "scopedResources",
      "apiVersion": "2021-07-01-preview"
    }
  ],
  "propertySemantics": [
    { "path": "*.logs", "collectionKey": "category,categoryGroup" },
    { "path": "*.metrics", "collectionKey": "category" },
    { "path": "*.privateDnsZoneConfigs", "collectionKey": "name" },
    { "path": "*.ipRules", "collectionKey": "value" },
    { "path": "*.virtualNetworkRules", "collectionKey": "id" },
    { "path": "*.resourceAccessRules", "collectionKey": "resourceId,tenantId" },
    { "path": "*.virtualNetworkPeerings", "collectionKey": "name" },
    { "path": "*.aRecords", "collectionKey": "ipv4Address" },
    { "path": "*.aaaaRecords", "collectionKey": "ipv6Address" },
    { "path": "*.mxRecords", "collectionKey": "preference,exchange" },
    { "path": "*.srvRecords", "collectionKey": "priority,weight,port,target" },
    { "path": "*.ptrRecords", "collectionKey": "ptrdname" },
    { "path": "*.txtRecords", "collectionKey": "value" }
  ],
  "source": "shared/azure-resource-configs.md",
  "globalSkuRules": [
    {
      "resourceTypePattern": "*",
      "property": "skuName",
      "armJsonPath": "sku.name",
      "normalization": "caseInsensitive",
      "notes": "Extract from top-level sku object when present"
    },
    {
      "resourceTypePattern": "*",
      "property": "skuTier",
      "armJsonPath": "sku.tier",
      "normalization": "caseInsensitive",
      "notes": "Extract from top-level sku object when present"
    },
    {
      "resourceTypePattern": "*",
      "property": "location",
      "armJsonPath": "location",
      "normalization": "region"
    }
  ],
  "compositeRules": [
    {
      "resourceType": "Microsoft.Compute/virtualMachines",
      "property": "osImage",
      "assembledFrom": [
        "properties.storageProfile.imageReference.publisher",
        "properties.storageProfile.imageReference.offer",
        "properties.storageProfile.imageReference.sku",
        "properties.storageProfile.imageReference.version"
      ],
      "format": "publisher:offer:sku:version"
    }
  ],
  "resourceTypes": [
    {
      "resourceType": "Microsoft.Insights/privateLinkScopes/scopedResources",
      "severity": "standard",
      "properties": [
        { "name": "linkedResourceId", "armJsonPath": "properties.linkedResourceId", "normalization": "caseInsensitive" }
      ]
    },
    {
      "resourceType": "Microsoft.Insights/diagnosticSettings",
      "severity": "standard",
      "properties": [
        { "name": "workspaceId", "armJsonPath": "properties.workspaceId", "normalization": "caseInsensitive" },
        { "name": "storageAccountId", "armJsonPath": "properties.storageAccountId", "normalization": "caseInsensitive" },
        { "name": "eventHubAuthorizationRuleId", "armJsonPath": "properties.eventHubAuthorizationRuleId", "normalization": "caseInsensitive" }
      ]
    },
    {
      "resourceType": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "severity": "standard",
      "properties": []
    },
    {
      "resourceType": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "severity": "standard",
      "properties": [
        { "name": "allowVirtualNetworkAccess", "armJsonPath": "properties.allowVirtualNetworkAccess" },
        { "name": "allowForwardedTraffic", "armJsonPath": "properties.allowForwardedTraffic" },
        { "name": "allowGatewayTransit", "armJsonPath": "properties.allowGatewayTransit" },
        { "name": "useRemoteGateways", "armJsonPath": "properties.useRemoteGateways" },
        { "name": "remoteVirtualNetworkId", "armJsonPath": "properties.remoteVirtualNetwork.id", "normalization": "caseInsensitive" }
      ]
    },
    {
      "resourceType": "Microsoft.Storage/storageAccounts/blobServices",
      "severity": "standard",
      "properties": []
