{
  "version": 1,
  "source": "shared/azure-resource-configs.md",
  "globalSkuRules": [
    {
      "resourceTypePattern": "*",
      "property": "skuName",
      "armJsonPath": "sku.name",
      "normalization": "caseInsensitive",
      "notes": "Extract from top-level sku object when present"
    },
    {
      "resourceTypePattern": "*",
      "property": "skuTier",
      "armJsonPath": "sku.tier",
      "normalization": "caseInsensitive",
      "notes": "Extract from top-level sku object when present"
    },
    {
      "resourceTypePattern": "*",
      "property": "location",
      "armJsonPath": "location",
      "normalization": "region"
    }
  ],
  "compositeRules": [
    {
      "resourceType": "Microsoft.Compute/virtualMachines",
      "property": "osImage",
      "assembledFrom": [
        "properties.storageProfile.imageReference.publisher",
        "properties.storageProfile.imageReference.offer",
        "properties.storageProfile.imageReference.sku",
        "properties.storageProfile.imageReference.version"
      ],
      "format": "publisher:offer:sku:version"
    }
  ],
  "resourceTypes": [
    {
      "resourceType": "Microsoft.Compute/virtualMachines",
      "mcpTool": "mcp_azure_compute",
      "fallback": "az vm show --ids <resourceId> -o json",
      "severity": "standard",
      "properties": [
        {
          "name": "vmSize",
          "normalization": "caseInsensitive",
          "armJsonPath": "properties.hardwareProfile.vmSize"
        },
        {
          "name": "osType",
          "normalization": "caseInsensitive",
          "armJsonPath": "properties.storageProfile.osDisk.osType"
        },
        {
          "name": "osImage",
          "armJsonPath": "composite:osImage"
        },
        {
          "name": "osDiskType",
          "normalization": "caseInsensitive",
          "armJsonPath": "properties.storageProfile.osDisk.managedDisk.storageAccountType"
        },
        {
          "name": "osDiskSizeGB",
          "armJsonPath": "properties.storageProfile.osDisk.diskSizeGB"
        },
        {
          "name": "dataDisks",
          "armJsonPath": "properties.storageProfile.dataDisks"
        },
        {
          "name": "adminUsername",
          "armJsonPath": "properties.osProfile.adminUsername"
        },
        {
          "name": "authenticationType",
          "armJsonPath": "properties.osProfile.linuxConfiguration.disablePasswordAuthentication"
        },
        {
          "name": "enableBootDiagnostics",
          "armJsonPath": "properties.diagnosticsProfile.bootDiagnostics.enabled"
        },
        {
          "name": "availabilityZone",
          "armJsonPath": "zones[0]"
        },
        {
          "name": "enableAcceleratedNetworking",
          "armJsonPath": "properties.networkProfile.networkInterfaces[0].id"
        }
      ]
    },
